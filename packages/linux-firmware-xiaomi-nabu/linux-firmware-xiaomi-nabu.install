post_install() {
  cat << 'EOF'
>>> Xiaomi Pad 5 (nabu) Firmware Installation Notes:
>>> To prevent upstream 'linux-firmware-atheros' package updates from
>>> overwriting the calibrated WCN3990 Wi-Fi BDF and DSP firmware, ensure
>>> your /etc/pacman.conf contains:
>>>
>>>   NoExtract = usr/lib/firmware/ath10k/WCN3990/hw1.0/*
>>>
EOF
}

post_upgrade() {
  post_install
}
