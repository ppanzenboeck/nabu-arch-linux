# Maintainer: Panz Dev <panz.development@gmail.com>
# Contributor / Upstream Lineage:
#   Kumar-Jy <https://github.com/Kumar-Jy/linux-nabu> (Xiaomi Pad 5 mainline kernel integration & display bringup)
#   postmarketOS SM8150 team <https://gitlab.postmarketos.org/soc/qualcomm-sm8150/linux> (Mainline Linux SM8150 SoC port)
pkgname=linux-nabu-70
pkgver=7.0.0
pkgrel=1
pkgdesc="Linux mainline kernel 7.0 (sm8150 postmarketOS port) for Xiaomi Pad 5 (nabu, SM8150)"
arch=('aarch64')
url="https://gitlab.postmarketos.org/soc/qualcomm-sm8150/linux"
license=('GPL-2.0-only')
depends=(
  'coreutils'
  'initramfs'
  'kmod'
)
optdepends=(
  'linux-firmware-xiaomi-nabu: proprietary firmware blobs for Xiaomi Pad 5'
  'wireless-regdb: regulatory domain database'
)
provides=('WIREGUARD-MODULE')
options=(!strip !debug)
source=(
  "linux::git+https://gitlab.postmarketos.org/soc/qualcomm-sm8150/linux.git#branch=sm8150/7.0-wip"
  "0001-sm8150-70-nabu-fixes.patch"
  "config"
  "linux-nabu-70.preset"
  "linux-nabu-70.hook"
)
sha256sums=(
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
)

prepare() {
  cd linux
  patch -Np1 -i "${srcdir}/0001-sm8150-70-nabu-fixes.patch"
  cp "${srcdir}/config" .config
  make ARCH=arm64 CROSS_COMPILE=aarch64-linux-gnu- olddefconfig
}

build() {
  cd linux
  make -j$(nproc) ARCH=arm64 CROSS_COMPILE=aarch64-linux-gnu- Image dtbs modules
}

package() {
  cd linux

  # Install modules
  make ARCH=arm64 CROSS_COMPILE=aarch64-linux-gnu- INSTALL_MOD_PATH="${pkgdir}/usr" INSTALL_MOD_STRIP=1 modules_install

  # Remove build and source symlinks pointing to build host paths
  rm -rf "${pkgdir}"/usr/lib/modules/*/build
  rm -rf "${pkgdir}"/usr/lib/modules/*/source

  # Install kernel image and Device Tree Blob (DTB)
  install -Dm644 arch/arm64/boot/Image "${pkgdir}/boot/vmlinuz-linux-nabu-70"
  install -Dm644 arch/arm64/boot/dts/qcom/sm8150-xiaomi-nabu.dtb "${pkgdir}/boot/dtb-linux-nabu-70"

  # Install mkinitcpio preset and libalpm hook
  install -Dm644 "${srcdir}/linux-nabu-70.preset" "${pkgdir}/etc/mkinitcpio.d/linux-nabu-70.preset"
  install -Dm644 "${srcdir}/linux-nabu-70.hook" "${pkgdir}/usr/share/libalpm/hooks/90-linux-nabu-70.hook"
}
